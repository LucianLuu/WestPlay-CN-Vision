/target
node_modules/
dist/
*.log

# Third-party tools that aren't ours to redistribute
/tools/scs_extractor/

# Apple/third-party icons and wallpapers used only as development placeholders; never commit or ship
/ui/public/placeholder-icons/
/ui/public/placeholder-icons-dark/
/ui/public/placeholder-wallpapers/

# Truck brand logos (trademarks): kept out of the repository; shipped later as a removable asset pack
/ui/public/brand-logos/

# Map data exported from the developer's own game files (crates/mapdata, examples/export_area): game
# content, never committed or shipped; players' maps are built from their own games
/ui/public/dev-map/

# The public repository's clone, for releases (tools/release/publish.ps1)
/public/

# Local Claude Code settings
/.claude/

# Signing keys (the updater's private key stays with its owner, outside the repository)
*.key

# Real CarPlay photos the owner took, for reference only: Apple's UI in someone's car, never committed or shipped
/reference/

# Build outputs copied in for bundling (the build script fills them; never committed)
/app/dist-plugin/
/ui/dist/

# The QQ middle layer as shipped: the embeddable interpreter, its dependencies and the compiled
# layer (69 MB). Built by tools/scripts/build-qq-layer.ps1 from the layer's own sources; the
# release installer carries it (app/tauri.conf.json's `qq-music-layer/` resource).
/app/qq-music-layer/

# NetEase Cloud Music's layer runtime: the embeddable interpreter and the layer's code staged beside
# it (about 19 MB). Built by tools/scripts/build-netease-layer.ps1 from `netease_layer/`; the release
# installer carries it (app/tauri.conf.json's `netease-layer/` resource). The layer's own sources
# (`netease_layer/`) are committed as usual.
/netease-layer/

# The released installers and manifests (build/<version>/)
/build/

# Signing keys: the updater's private key stays with its owner, outside the repository
*.key
*.key.pub

# WestPlay CN Vision: the layer's own compiled sources are built, not committed
*.pyc
__pycache__/
# 3.0 的界面源码与构建产物：原作者不再公开，这些不进仓库（owner 2026-11-23）
/ui/src/cabin/shell/glass-30.css
/ui/src/companion/motion.css
/ui/src/companion/titlebar.css
/ui/src/companion/WindowControls.tsx
/ui/src/cn-standalone.tsx
/ui/vite.cn-standalone.config.ts

# 3.0 的移植笔记：记着构建方法和产物哈希，不进仓库
/docs/移植3.0-未解决的难题.md
/docs/移植3.0-难题解决方案.md

